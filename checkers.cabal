cabal-version:      2.4
name:               checkers
version:            0.1.0.0
build-type:         Simple

common shared
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:    base, containers

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  Model
executable checkers
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    checkers

test-suite spec
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    checkers